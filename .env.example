# Your shop name (https://admin.shopify.com/store/YOUR_SHOP_NAME)
# Until NUXT_SHOPIFY_NAME and the Storefront token below are set, the app uses the
# demo store in nuxt.config.ts. Demo prices are not rupees.
#
# When you connect your own store:
# 1. Set NUXT_SHOPIFY_NAME to the handle in the admin URL.
# 2. Set NUXT_SHOPIFY_CLIENTS_STOREFRONT_PUBLIC_ACCESS_TOKEN to a Storefront API public token.
# 3. Publish products in Shopify. Use a product type such as "T-Shirts" and an optional
#    tag like "240 GSM" so product cards can show that spec.
# 4. In the Aviva dashboard, connect Shopify order sync. Aviva fulfills paid orders.
#    The storefront does not call Aviva directly.
# 5. Publish India as the only market, with English and Tamil. The storefront
#    already uses those two languages and sends country IN on every request.
NUXT_SHOPIFY_NAME="YOUR_SHOP_NAME"

# Storefront API
NUXT_SHOPIFY_CLIENTS_STOREFRONT_API_VERSION="2026-04"
NUXT_SHOPIFY_CLIENTS_STOREFRONT_PUBLIC_ACCESS_TOKEN="YOUR_PUBLIC_ACCESS_TOKEN"

# Customer Account API
NUXT_SHOPIFY_CLIENTS_CUSTOMER_ACCOUNT_CLIENT_ID="YOUR_CUSTOMER_ACCOUNT_CLIENT_ID"

# Required in production (>= 32 characters). Generated automatically in development.
NUXT_SHOPIFY_CLIENTS_CUSTOMER_ACCOUNT_SESSION_PASSWORD="A_RANDOM_32_CHARACTER_OR_LONGER_SECRET"
